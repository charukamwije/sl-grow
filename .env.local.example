# Optional: leave the three Supabase values unset to run in guest mode (no
# accounts). Set all three to enable Google sign-in, the cloud cart, order
# history and plans. Find them in the Supabase dashboard under
# Project Settings > API Keys (and the project URL under Data API).
#
# All three are read on the server only. The browser never talks to Supabase.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# The publishable (anon) key. Used for sign-in and sessions; the tables deny
# it everything.
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# The secret (service_role) key. Reads and writes the tables and deletes
# accounts. Keep it out of git and out of anything public.
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# Public URL of this deployment, used for metadata, robots.txt and the sitemap.
# Optional: falls back to the Vercel production domain, then http://localhost:3000
# SITE_URL=https://your-app.vercel.app
